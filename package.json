{
  "name": "raffle-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@raffle/web",
    "dev:admin": "turbo run dev --filter=@raffle/admin",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=@raffle/web",
    "start:admin": "turbo run start --filter=@raffle/admin",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "npm --workspace=@raffle/database run db:migrate",
    "db:migrate:deploy": "npm --workspace=@raffle/database run db:migrate:deploy",
    "db:migrate:status": "npm --workspace=@raffle/database run db:migrate:status",
    "db:seed": "turbo run db:seed",
    "db:switch:pg": "node scripts/switch-db.js postgresql",
    "db:switch:sqlite": "node scripts/switch-db.js sqlite"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.8"
}
