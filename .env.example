# ==============================================================================
# LUCKYETHIO (IDIL) ENTERPRISE RAFFLE PLATFORM — PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / AWS RDS)
# ------------------------------------------------------------------------------
# For Local Dev (SQLite):
# DATABASE_URL="file:./dev.db"
#
# For Production (PostgreSQL):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host.com:5432/luckyethio_db?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOSTING URLS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="LuckyEthio Raffle"

# Customer Portal Public Domain (e.g., https://luckyethio.com)
NEXT_PUBLIC_BASE_URL="https://your-production-domain.com"

# Admin Operations Console Public Domain (e.g., https://admin.luckyethio.com)
NEXT_PUBLIC_ADMIN_URL="https://admin.your-production-domain.com"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="generate_a_random_secure_64_character_hex_or_base64_secret_key"
NEXTAUTH_SECRET="generate_a_random_secure_64_character_hex_or_base64_secret_key"
NEXTAUTH_URL="https://your-production-domain.com"

# Master Pre-Commitment Salt & HMAC Secret
RNG_PUBLIC_ENTROPY="ETHIO-TELECOM-NLA-CONSENSUS"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATIONS (Live API Credentials)
# ------------------------------------------------------------------------------
# A. Chapa Payment Gateway (https://chapa.co)
CHAPA_PUBLIC_KEY="CHAPUBK-your-live-public-key"
CHAPA_SECRET_KEY="CHASECK-your-live-secret-key"
CHAPA_WEBHOOK_SECRET="your-live-chapa-webhook-secret"

# B. Telebirr Payment Gateway (Ethio Telecom API)
TELEBIRR_APP_ID="your-telebirr-app-id"
TELEBIRR_APP_KEY="your-telebirr-app-key"
TELEBIRR_PUBLIC_KEY="your-telebirr-public-key"
TELEBIRR_SHORTCODE="157"

# C. Commercial Bank of Ethiopia (CBE Birr Host-to-Host)
CBE_BIRR_MERCHANT_ID="your-cbe-birr-merchant-id"
CBE_BIRR_API_KEY="your-cbe-birr-api-key"

# D. SantimPay (https://santimpay.com)
SANTIMPAY_MERCHANT_ID="your-santimpay-merchant-id"
SANTIMPAY_PRIVATE_KEY="your-santimpay-private-key"
SANTIMPAY_TOKEN="your-santimpay-auth-token"

# ------------------------------------------------------------------------------
# 5. TELECOM SMS & USSD GATEWAY
# ------------------------------------------------------------------------------
SMS_GATEWAY_URL="https://api.africastalking.com/version1/messaging"
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_SENDER_ID="LUCKYETHIO"
USSD_SHORTCODE="*157#"

# ------------------------------------------------------------------------------
# 6. DOCKER & STANDALONE SETTINGS
# ------------------------------------------------------------------------------
NEXT_OUTPUT_STANDALONE="true"
